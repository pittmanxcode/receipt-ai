<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the Keep -> Notion capture bridge.

  Fill in the two placeholders before installing:
    __PROJECT_DIR__   absolute path to this project directory
    __VENV_PYTHON__   absolute path to the venv's python3

  See README.md for the install and verify commands.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.michael.keepbridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PYTHON__</string>
        <string>__PROJECT_DIR__/sync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- Every 15 minutes while the Mac is awake. A run that is still going
         when the next one fires is skipped by sync.py's own lock. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
